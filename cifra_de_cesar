#include <stdio.h>
#include <string.h>

int main() {
    char palavra[16];
    char criptografada[16];
    int shift;
    int tipo;
    int i;
    int n;
    int valorSequencia;
    int anterior1, anterior2, atual;
    int primo;
    int a, b;
    FILE *arquivo;

    printf("Digite a palavra (ate 15 letras, sem acentos): ");
    scanf("%15s", palavra);
    printf("Digite o SHIFT: ");
    scanf("%d", &shift);
    printf("\nEscolha a sequencia numerica:\n");
    printf("1 - PA\n");
    printf("2 - PG\n");
    printf("3 - Fibonacci\n");
    printf("4 - Numeros Primos\n");
    printf("Escolha: ");
    scanf("%d", &tipo);

    n = strlen(palavra);

    for (i = 0; i < n; i++) {
        if (tipo == 1) {
            valorSequencia = 1 + i;
        } else if (tipo == 2) {

            valorSequencia = 1;
            for (a = 0; a < i; a++) {
                valorSequencia = valorSequencia * 2;
            }
        } else if (tipo == 3) {
            if (i == 0 || i == 1) {
                valorSequencia = 1;
            } else {
                anterior1 = 1;
                anterior2 = 1;
                for (a = 2; a <= i; a++) {
                    atual = anterior1 + anterior2;
                    anterior1 = anterior2;
                    anterior2 = atual;
                }
                valorSequencia = anterior2;
            }
        } else if (tipo == 4) {
            primo = 1;
            valorSequencia = 0;
            while (valorSequencia <= i) {
                primo++;
                int ehPrimo = 1;
                if (primo == 1) {
                    ehPrimo = 0;
                }
                for (b = 2; b < primo; b++) {
                    if (primo % b == 0) {
                        ehPrimo = 0;
                        break;
                    }
                }
                if (ehPrimo == 1) {
                    valorSequencia++;
                }
            }
            valorSequencia = 0;
            primo = 1;
            while (valorSequencia <= i) {
                primo++;
                int ehPrimo = 1;
                for (b = 2; b < primo; b++) {
                    if (primo % b == 0) {
                        ehPrimo = 0;
                        break;
                    }
                }
                if (ehPrimo == 1) {
                    valorSequencia++;
                }
            }
            valorSequencia = primo;
        } else {
            printf("Opcao de sequencia invalida.\n");
            return 1;
        }
        criptografada[i] =
            ((palavra[i] - 'a') + shift + valorSequencia) % 26 + 'a';
    }

    criptografada[n] = '\0';
    printf("\nPalavra original: %s\n", palavra);
    printf("SHIFT: %d\n", shift);

    printf("Sequencia: ");

    if (tipo == 1) {
        printf("PA\n");
    } else if (tipo == 2) {
        printf("PG\n");
    } else if (tipo == 3) {
        printf("Fibonacci\n");
    } else if (tipo == 4) {
        printf("Numeros Primos\n");
    }
    printf("Palavra criptografada: %s\n", criptografada);
    arquivo = fopen("resultado_criptografia.txt", "w");

    if (arquivo == NULL) {
        printf("Erro ao criar o arquivo.\n");
        return 1;
    }
    fprintf(arquivo,
            "Palavra codificada: %s | SHIFT: %d | Tipo: %d | Letras: %d\n",
            criptografada, shift, tipo, n);
    fclose(arquivo);
    printf("Arquivo gerado (resultado_criptografia.txt).\n");
    return 0;
}
